.container { padding: 20rpx; background: #f5f5f5; min-height: 100vh; }

.form { background: #fff; border-radius: 16rpx; overflow: hidden; }

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item .label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.form-item input, .form-item textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-item textarea {
  min-height: 80rpx;
  width: 100%;
}

.switch-item {
  justify-content: space-between;
}

.region-text {
  font-size: 28rpx;
  color: #333;
}

.btn-save {
  margin-top: 60rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}