<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon-text">🔍</text>
      <input class="search-input" placeholder="搜索商品名称" value="{{searchInput}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
      <view class="search-clear" wx:if="{{searchInput}}" bindtap="onSearchClear">
        <text>✕</text>
      </view>
    </view>
  </view>

  <!-- 分类Tab -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view class="category-tabs">
      <view class="category-tab {{activeCategory === '' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="">
        <text>全部</text>
      </view>
      <view class="category-tab {{activeCategory === item ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this" bindtap="onCategoryTap" data-category="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view class="sort-item {{activeSort === item.key ? 'active' : ''}}" wx:for="{{sortOptions}}" wx:key="key" bindtap="onSortTap" data-sort="{{item.key}}">
      <text>{{item.label}}</text>
    </view>
    <view class="sort-count">
      <text>共{{total}}件</text>
    </view>
  </view>

  <!-- 商品网格 -->
  <view class="product-grid">
    <view class="product-card" wx:for="{{products}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="card-image-wrap">
        <image class="product-image" src="{{item.full_image || item.image || '/assets/default-avatar.png'}}" mode="aspectFill" lazy-load></image>
        <view class="card-tag" wx:if="{{item.category}}">
          <text>{{item.category}}</text>
        </view>
      </view>
      <view class="card-body">
        <text class="product-name">{{item.name}}</text>
        <text class="product-desc">{{item.description}}</text>
        <view class="card-footer">
          <text class="product-price">¥{{item.price_text}}</text>
          <text class="product-stock">{{item.stock_text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && products.length === 0}}">
    <image class="empty-icon" src="/assets/empty.png" mode="aspectFit" wx:if="{{false}}"></image>
    <text class="empty-text">暂无商品</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{noMore && products.length > 0}}">
    <text>— 已经到底了 —</text>
  </view>
</view>