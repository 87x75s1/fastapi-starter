.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 搜索栏 ========== */
.search-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon-text {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 72rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ccc;
  border-radius: 50%;
  margin-left: 8rpx;
}

.search-clear text {
  font-size: 22rpx;
  color: #fff;
}

/* ========== 分类Tab ========== */
.category-scroll {
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  white-space: nowrap;
}

.category-tabs {
  display: inline-flex;
  padding: 0 24rpx;
  height: 88rpx;
  align-items: center;
  gap: 8rpx;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
  transition: all 0.2s;
}

.category-tab.active {
  background: #e8f5e9;
  color: #4CAF50;
  font-weight: 600;
}

/* ========== 排序栏 ========== */
.sort-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 80rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 4rpx;
}

.sort-item {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #888;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.sort-item.active {
  color: #4CAF50;
  font-weight: 600;
  background: #e8f5e9;
}

.sort-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #bbb;
}

/* ========== 商品网格 ========== */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 16rpx 0;
  gap: 16rpx;
}

.product-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-image-wrap {
  position: relative;
  width: 100%;
  height: 340rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

.card-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(76, 175, 80, 0.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.card-body {
  padding: 16rpx 20rpx 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  min-height: 78rpx;
}

.product-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product-price {
  font-size: 34rpx;
  font-weight: bold;
  color: #e4393c;
}

.product-stock {
  font-size: 20rpx;
  color: #bbb;
}

/* ========== 空状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #ccc;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
  gap: 12rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e0e0e0;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: #ccc;
  font-size: 24rpx;
}