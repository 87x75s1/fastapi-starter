.container { padding-bottom: 120rpx; }

.product-image {
  width: 100%;
  height: 500rpx;
}

.product-info {
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.product-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.product-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.product-price {
  font-size: 44rpx;
  color: #e4393c;
  font-weight: bold;
}

.product-stock {
  font-size: 26rpx;
  color: #999;
}

.product-category {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.quantity-label {
  font-size: 30rpx;
  color: #333;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 36rpx;
  background: #f5f5f5;
  border: none;
  padding: 0;
  margin: 0;
  border-radius: 8rpx;
}

.qty-input {
  width: 80rpx;
  height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  margin: 0 10rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.buy-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.btn-buy {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
}

.modal-content {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  max-height: 70vh;
  z-index: 201;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.address-list {
  max-height: 50vh;
  overflow-y: auto;
}

.address-item {
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.address-selected {
  border-color: #4CAF50;
  background: #f1f8f1;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.name { font-weight: bold; margin-right: 16rpx; }
.phone { color: #666; margin-right: 16rpx; }
.default-tag {
  font-size: 22rpx;
  color: #4CAF50;
  border: 1rpx solid #4CAF50;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
}

.btn-confirm {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 20rpx;
  border: none;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}