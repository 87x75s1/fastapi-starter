<view class="container" wx:if="{{product}}">
  <!-- 商品图片 -->
  <image class="product-image" src="{{product.full_image || product.image || '/assets/default-avatar.png'}}" mode="aspectFill"></image>

  <!-- 商品信息 -->
  <view class="product-info">
    <text class="product-name">{{product.name}}</text>
    <text class="product-desc">{{product.description}}</text>
    <view class="price-row">
      <text class="product-price">¥{{product.price_text}}</text>
      <text class="product-stock">{{product.stock_text}}</text>
    </view>
    <text class="product-category" wx:if="{{product.category}}">分类: {{product.category}}</text>
  </view>

  <!-- 数量选择 -->
  <view class="quantity-section">
    <text class="quantity-label">购买数量</text>
    <view class="quantity-control">
      <button class="qty-btn" bindtap="onQuantityMinus">-</button>
      <input class="qty-input" type="number" value="{{quantity}}" bindinput="onQuantityInput" />
      <button class="qty-btn" bindtap="onQuantityPlus">+</button>
    </view>
  </view>

  <!-- 立即购买 -->
  <view class="buy-section">
    <button class="btn-buy" bindtap="onBuyNow">立即购买</button>
  </view>

  <!-- 地址选择弹窗 -->
  <view class="modal-mask" wx:if="{{showAddressPicker}}" bindtap="onCancelAddress"></view>
  <view class="modal-content" wx:if="{{showAddressPicker}}">
    <view class="modal-header">
      <text class="modal-title">选择收货地址</text>
      <text class="modal-close" bindtap="onCancelAddress">✕</text>
    </view>
    <view class="address-list">
      <view class="address-item {{selectedAddress.id === item.id ? 'address-selected' : ''}}"
            wx:for="{{addresses}}" wx:key="id"
            bindtap="onSelectAddress" data-id="{{item.id}}">
        <view class="address-top">
          <text class="name">{{item.name}}</text>
          <text class="phone">{{item.phone}}</text>
          <text class="default-tag" wx:if="{{item.is_default === 1}}">默认</text>
        </view>
        <text class="address-detail">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text>
      </view>
    </view>
    <button class="btn-confirm" bindtap="onConfirmAddress">确认下单</button>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>