/* 管理后台 - 浅色商务风格 */
/* 色板: 深炭灰#2A2A33 / 浅灰底#F7F8FA / 强调色哑光深灰蓝#C45A5A / 警示红#C45A5A */
.container { background: #F7F8FA; min-height: 100vh; padding-bottom: 40rpx; }

/* 顶部导航栏 */
.nav-bar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background-color: #2A2A33;
  padding-top: var(--status-bar-height, 44px);
}
.nav-bar-inner {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; position: relative;
}
.nav-title { font-size: 34rpx; font-weight: 600; color: #FFFFFF; letter-spacing: 2rpx; }
.nav-back {
  position: absolute; left: 24rpx; top: 50%; transform: translateY(-50%);
  width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
}
.nav-back-arrow { width: 36rpx; height: 36rpx; border-left: 4rpx solid #FFFFFF; border-bottom: 4rpx solid #FFFFFF; transform: rotate(45deg); }

/* Tab导航 */
.nav {
  display: flex; background: #2A2A33; position: sticky; top: 0; z-index: 10;
  border-bottom: none; overflow-x: auto; white-space: nowrap;
  padding: 0 8rpx;
}
.nav-item {
  flex-shrink: 0; padding: 24rpx 28rpx; font-size: 26rpx; color: rgba(255,255,255,0.5);
  text-align: center; position: relative; letter-spacing: 1rpx;
}
.nav-active {
  color: #FFFFFF; font-weight: 600;
}
.nav-active::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 40rpx; height: 6rpx; background: #C45A5A; border-radius: 3rpx;
}

.panel { padding: 24rpx; }

/* 统计卡片 */
.stats-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.stat-card {
  width: calc(50% - 10rpx); background: #FFFFFF; border-radius: 16rpx; padding: 32rpx;
  text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.stat-num { display: block; font-size: 48rpx; font-weight: 700; color: #C45A5A; }
.stat-label { display: block; font-size: 24rpx; color: #999999; margin-top: 8rpx; }

/* 搜索栏 */
.search-bar {
  background: #FFFFFF; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.search-input {
  width: 100%; height: 68rpx; background: #F7F8FA; border-radius: 12rpx;
  padding: 0 24rpx; font-size: 26rpx; box-sizing: border-box; color: #333;
}

/* 分类筛选 */
.category-bar {
  background: #FFFFFF; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx;
  white-space: nowrap; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.cat-item {
  display: inline-block; padding: 12rpx 28rpx; font-size: 24rpx; color: #666666;
  border-radius: 8rpx; margin-right: 12rpx; background: #F7F8FA;
  transition: all 0.2s ease;
}
.cat-active { background: #C45A5A; color: #FFFFFF; }

/* 表单区域 */
.form-section {
  background: #FFFFFF; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.form-title { font-size: 30rpx; font-weight: 600; color: #2A2A33; margin-bottom: 24rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label {
  display: block; font-size: 26rpx; color: #666666; margin-bottom: 10rpx; font-weight: 500;
}
.required { color: #C45A5A; margin-right: 4rpx; }
.input {
  width: 100%; height: 80rpx; border: 1rpx solid #E8E8E8; border-radius: 12rpx;
  padding: 0 24rpx; font-size: 28rpx; box-sizing: border-box; background: #F7F8FA;
  line-height: 80rpx; color: #333;
}
.input:focus { border-color: #C45A5A; background: #FFFFFF; }
.textarea {
  width: 100%; border: 1rpx solid #E8E8E8; border-radius: 12rpx; padding: 20rpx 24rpx;
  font-size: 28rpx; min-height: 180rpx; box-sizing: border-box; background: #F7F8FA;
  line-height: 1.6; color: #333;
}
.textarea:focus { border-color: #C45A5A; background: #FFFFFF; }
.form-btns { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btn-primary {
  flex: 1; background: #C45A5A; color: #FFFFFF; border-radius: 12rpx; font-size: 28rpx;
  border: none; height: 84rpx; line-height: 84rpx; font-weight: 500;
}
.btn-cancel {
  flex: 1; background: #FFFFFF; color: #666666; border-radius: 12rpx; font-size: 28rpx;
  border: 1rpx solid #E8E8E8; height: 84rpx; line-height: 84rpx;
}

/* 列表区域 */
.list-section {
  background: #FFFFFF; border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.list-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 28rpx; border-bottom: 1rpx solid #F0F0F0;
}
.list-title { font-size: 28rpx; font-weight: 600; color: #2A2A33; }
.list-count { font-size: 24rpx; color: #999999; }

/* 商品列表项 */
.product-item {
  display: flex; align-items: center; padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.product-item:last-child { border-bottom: none; }
.product-img {
  width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0;
  background: #F7F8FA;
}
.product-info { flex: 1; margin-left: 20rpx; overflow: hidden; }
.product-name-row { display: flex; align-items: center; gap: 12rpx; }
.product-name { font-size: 28rpx; color: #2A2A33; font-weight: 500; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.product-status {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 6rpx; flex-shrink: 0;
}
.status-on { background: #F9E8E8; color: #C45A5A; }
.status-off { background: #FFF3E8; color: #D4915A; }
.product-desc {
  font-size: 24rpx; color: #999999; margin-top: 6rpx; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}
.product-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; }
.product-price { font-size: 28rpx; color: #C45A5A; font-weight: 600; }
.product-stock { font-size: 22rpx; color: #999999; }
.product-category {
  font-size: 20rpx; color: #C45A5A; background: #F9E8E8;
  padding: 2rpx 12rpx; border-radius: 6rpx;
}
.product-actions { display: flex; flex-direction: column; gap: 12rpx; flex-shrink: 0; margin-left: 12rpx; }
.btn-edit {
  font-size: 24rpx; color: #C45A5A; padding: 10rpx 22rpx;
  border: 1rpx solid #C45A5A; border-radius: 8rpx; text-align: center;
}
.btn-del {
  font-size: 24rpx; color: #C45A5A; padding: 10rpx 22rpx;
  border: 1rpx solid #C45A5A; border-radius: 8rpx; text-align: center;
}

.empty-tip {
  padding: 80rpx 0; text-align: center; font-size: 28rpx; color: #CCCCCC;
}
.load-more {
  padding: 28rpx; text-align: center; font-size: 26rpx; color: #C45A5A;
  border-top: 1rpx solid #F0F0F0;
}

/* 通用列表项（配置等） */
.list-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx; border-bottom: 1rpx solid #F0F0F0; background: #FFFFFF;
}
.list-item:last-child { border-bottom: none; }

/* 订单 */
.order-item {
  background: #FFFFFF; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.order-header { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.order-no { font-size: 24rpx; color: #999999; }
.order-amount { font-size: 30rpx; font-weight: 600; color: #C45A5A; }
.order-items { font-size: 24rpx; color: #666666; margin-bottom: 12rpx; line-height: 1.6; }
.order-footer { display: flex; align-items: center; justify-content: space-between; }
.status-text { font-size: 24rpx; font-weight: 600; }
.status-0 { color: #D4915A; }
.status-1 { color: #C45A5A; }
.status-2 { color: #999999; }
.status-3 { color: #C45A5A; }
.order-btns { display: flex; gap: 12rpx; }

/* 反馈 */
.feedback-item {
  background: #FFFFFF; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.fb-header { margin-bottom: 8rpx; }
.fb-status { font-size: 24rpx; font-weight: 600; padding: 4rpx 14rpx; border-radius: 6rpx; }
.fb-pending { color: #D4915A; background: #FFF3E8; }
.fb-done { color: #C45A5A; background: #F9E8E8; }
.fb-content { font-size: 28rpx; color: #2A2A33; line-height: 1.5; }
.fb-reply { background: #F7F8FA; border-radius: 12rpx; padding: 16rpx; margin-top: 12rpx; font-size: 26rpx; color: #666666; }
.fb-action { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.reply-input { flex: 1; border: 1rpx solid #E8E8E8; border-radius: 12rpx; padding: 12rpx 16rpx; font-size: 26rpx; background: #F7F8FA; }

/* 配置 */
.config-info { flex: 1; }
.config-key { font-size: 28rpx; color: #2A2A33; font-weight: 600; display: block; }
.config-val { font-size: 24rpx; color: #666666; margin-top: 4rpx; display: block; }

/* 用户管理 */
.user-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx; background: #FFFFFF; border-radius: 16rpx; margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.user-info { display: flex; align-items: center; gap: 12rpx; }
.user-name { font-size: 28rpx; color: #2A2A33; }
.role-tag {
  font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 6rpx;
  background: #E8E8E8; color: #666666;
}
.role-admin { background: #C45A5A; color: #FFFFFF; }

/* 角色切换按钮 */
.btn-role-toggle {
  padding: 14rpx 32rpx; border-radius: 10rpx; font-size: 24rpx; text-align: center;
  font-weight: 500; white-space: nowrap; min-width: 140rpx;
}
.btn-role-add { background: #C45A5A; color: #FFFFFF; }
.btn-role-remove { background: #FFFFFF; color: #C45A5A; border: 1rpx solid #C45A5A; }

/* 页面顶部占位（适配自定义导航栏） */
.nav-placeholder { height: calc(var(--status-bar-height, 44px) + 88rpx); }