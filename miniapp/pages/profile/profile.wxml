<view class="container">
  <!-- 自定义导航栏(深色) -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="nav-title">我的</view>
    </view>
  </view>
  <view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 用户信息区域(深灰背景) -->
  <view class="user-header">
    <!-- 未登录 -->
    <view class="not-logged" wx:if="{{!isLoggedIn}}" bindtap="goLogin">
      <view class="avatar-wrap">
        <view class="avatar-placeholder"></view>
      </view>
      <view class="user-info-wrap">
        <text class="nickname-default">点击登录</text>
        <text class="tip-text">登录后享受更多功能</text>
      </view>
    </view>
    <!-- 已登录 -->
    <view class="logged" wx:if="{{isLoggedIn}}">
      <view class="avatar-wrap" bindtap="onChangeAvatar">
        <image class="avatar-img" src="{{userInfo.avatar || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="avatar-edit-badge">
          <text class="edit-icon">📷</text>
        </view>
      </view>
      <view class="user-info-wrap">
        <text class="nickname">{{userInfo.nickname || '未设置昵称'}}</text>
        <text class="phone">{{userInfo.phone}}</text>
      </view>
    </view>
  </view>

  <!-- 个人资料卡片 -->
  <view class="card-section">
    <view class="card-title">个人资料</view>
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="请输入昵称" maxlength="50" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">性别</text>
      <picker class="form-picker" mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <text class="picker-text">{{genderOptions[genderIndex]}}</text>
        <text class="picker-arrow">▸</text>
      </picker>
    </view>
    <button class="btn-save" bindtap="onUpdateProfile" loading="{{updateLoading}}">保存修改</button>
  </view>

  <!-- 我的服务卡片 -->
  <view class="card-section">
    <view class="card-title">我的服务</view>
    <view class="menu-item" bindtap="goOrders">
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">▸</text>
    </view>
    <view class="menu-item" bindtap="goAddress">
      <text class="menu-text">收货地址</text>
      <text class="menu-arrow">▸</text>
    </view>
    <view class="menu-item" bindtap="goFeedback">
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">▸</text>
    </view>
    <view class="menu-item" bindtap="goAdmin" wx:if="{{userInfo.role === 1}}">
      <text class="menu-text">管理后台</text>
      <text class="menu-arrow">▸</text>
    </view>
    <view class="menu-item" bindtap="goAdminPerm" wx:if="{{userInfo.role === 1}}">
      <text class="menu-text">权限管理</text>
      <text class="menu-arrow">▸</text>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>