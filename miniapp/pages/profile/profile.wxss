/* ========== 我的页面 - 炭灰极简轻奢 高保真 ========== */

.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding-bottom: 40rpx;
}

/* ========== 自定义导航栏(深色) ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background-color: #3A3A3A;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 3rpx;
}

/* ========== 用户信息区域(柔和炭灰背景) ========== */
.user-header {
  background-color: #3A3A3A;
  padding: 44rpx 36rpx 56rpx;
}

.not-logged {
  display: flex;
  align-items: center;
}

.logged {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.1);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  background-color: #555555;
  border-radius: 50%;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
}

.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  font-size: 18rpx;
}

.user-info-wrap {
  margin-left: 32rpx;
  flex: 1;
}

.nickname-default {
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 10rpx;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.nickname {
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 10rpx;
}

.phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ========== 白色卡片模块(宽松间距) ========== */
.card-section {
  margin: 28rpx 28rpx 0;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3A3A3A;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
  letter-spacing: 1rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-item:last-of-type {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #888888;
  width: 100rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #3A3A3A;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #3A3A3A;
}

.picker-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 保存修改按钮 - 哑光豆沙酒红长条形 */
.btn-save {
  width: 100%;
  height: 88rpx;
  background-color: #B55A5A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  margin-top: 36rpx;
  border: none;
  line-height: 88rpx;
  letter-spacing: 4rpx;
}

.btn-save::after {
  border: none;
}

/* 菜单项(宽松间距) */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 28rpx;
  color: #3A3A3A;
}

.menu-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 底部留白 */
.bottom-space {
  height: 40rpx;
}