<view class="page-container">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="nav-title">优品商城</view>
      <view class="nav-right">
        <view class="nav-icon-btn" bindtap="onSearchTap">
          <text class="nav-icon">⌕</text>
        </view>
        <view class="nav-icon-btn" bindtap="onMessageTap">
          <text class="nav-icon">✉</text>
        </view>
      </view>
    </view>
  </view>
  <view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 静态浅灰弱文案公告 -->
  <view class="notice-bar">
    <text class="notice-text">{{noticeText}}</text>
  </view>

  <!-- 为你精选 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">为你精选</text>
      <view class="section-more" bindtap="onViewMore">
        <text class="section-more-text">更多</text>
        <text class="section-more-arrow">›</text>
      </view>
    </view>
    <view class="product-grid">
      <view class="product-card" wx:for="{{featuredProducts}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
        <view class="product-img-wrap">
          <image class="product-img" src="{{item.image}}" mode="aspectFill" binderror="onImgError" />
          <view class="img-placeholder" wx:if="{{!item.image}}">
            <view class="placeholder-box"></view>
          </view>
        </view>
        <text class="product-name ellipsis-2">{{item.name}}</text>
        <view class="product-bottom">
          <view class="product-price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item.price}}</text>
          </view>
          <view class="cart-btn tap-scale" catchtap="onAddCart" data-id="{{item.id}}">
            <text class="cart-btn-icon">+</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 品质好物 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">品质好物</text>
      <view class="section-more" bindtap="onViewMore">
        <text class="section-more-text">更多</text>
        <text class="section-more-arrow">›</text>
      </view>
    </view>
    <view class="product-grid">
      <view class="product-card" wx:for="{{qualityProducts}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
        <view class="product-img-wrap">
          <image class="product-img" src="{{item.image}}" mode="aspectFill" binderror="onImgError" />
          <view class="img-placeholder" wx:if="{{!item.image}}">
            <view class="placeholder-box"></view>
          </view>
        </view>
        <text class="product-name ellipsis-2">{{item.name}}</text>
        <view class="product-bottom">
          <view class="product-price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item.price}}</text>
          </view>
          <view class="cart-btn tap-scale" catchtap="onAddCart" data-id="{{item.id}}">
            <text class="cart-btn-icon">+</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>