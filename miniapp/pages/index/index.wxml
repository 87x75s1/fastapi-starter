<view class="container">
  <!-- 顶部横幅 -->
  <view class="banner">
    <view class="banner-content">
      <text class="banner-title">FastAPI 小程序</text>
      <text class="banner-desc">开箱即用的微信小程序后台模板</text>
    </view>
    <text class="banner-icon">🚀</text>
  </view>

  <!-- 功能入口 -->
  <view class="features">
    <view class="feature-item" bindtap="goProfile">
      <view class="feature-icon-wrap" style="background: #E8F5E9;">
        <text class="feature-icon">👤</text>
      </view>
      <text class="feature-name">个人中心</text>
    </view>
    <view class="feature-item" bindtap="goUpload">
      <view class="feature-icon-wrap" style="background: #FFF3E0;">
        <text class="feature-icon">📷</text>
      </view>
      <text class="feature-name">图片上传</text>
    </view>
    <view class="feature-item" bindtap="goLogin">
      <view class="feature-icon-wrap" style="background: #E3F2FD;">
        <text class="feature-icon">🔐</text>
      </view>
      <text class="feature-name">登录注册</text>
    </view>
    <view class="feature-item" bindtap="checkBackend">
      <view class="feature-icon-wrap" style="background: #F3E5F5;">
        <text class="feature-icon">🔗</text>
      </view>
      <text class="feature-name">后端状态</text>
    </view>
  </view>

  <!-- 后端状态 -->
  <view class="section">
    <view class="section-title">后端服务状态</view>
    <view class="status-card">
      <view class="status-row">
        <text class="status-label">服务地址</text>
        <text class="status-value">{{baseUrl}}</text>
      </view>
      <view class="status-row">
        <text class="status-label">连接状态</text>
        <text class="status-value {{connected ? 'status-ok' : 'status-err'}}">{{connected ? '✅ 已连接' : '❌ 未连接'}}</text>
      </view>
      <view class="status-row" wx:if="{{connected}}">
        <text class="status-label">登录状态</text>
        <text class="status-value">{{isLoggedIn ? '✅ 已登录' : '⚠️ 未登录'}}</text>
      </view>
    </view>
  </view>

  <!-- 技术栈 -->
  <view class="section">
    <view class="section-title">技术栈</view>
    <view class="tech-list">
      <view class="tech-item" wx:for="{{techStack}}" wx:key="name">
        <text class="tech-name">{{item.name}}</text>
        <text class="tech-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
</view>