/* ========== 首页 - 炭灰极简轻奢 高保真 ========== */

.page-container {
  min-height: 100vh;
  background-color: #F8F9FA;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background-color: #FFFFFF;
  box-shadow: 0 0.5px 0 #EEEEEE;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  position: relative;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3A3A3A;
  letter-spacing: 3rpx;
}

.nav-right {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-icon-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  font-size: 36rpx;
  color: #3A3A3A;
}

/* ========== 静态浅灰弱文案公告 ========== */
.notice-bar {
  width: 100%;
  padding: 20rpx 32rpx 8rpx;
  background-color: #F8F9FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-text {
  font-size: 22rpx;
  color: #CCCCCC;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

/* ========== 板块区域(宽松间距) ========== */
.section {
  margin: 0 28rpx;
  padding-bottom: 8rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 0 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3A3A3A;
  letter-spacing: 2rpx;
}

.section-more {
  display: flex;
  align-items: center;
}

.section-more-text {
  font-size: 24rpx;
  color: #BBBBBB;
}

.section-more-arrow {
  font-size: 28rpx;
  color: #BBBBBB;
  margin-left: 4rpx;
}

/* ========== 商品双列网格 ========== */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: calc(50% - 14rpx);
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
  overflow: hidden;
  padding-bottom: 24rpx;
}

/* 商品图片区域 - 柔和浅灰 */
.product-img-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  border-radius: 16rpx 16rpx 0 0;
  background-color: #F5F5F5;
}

.product-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.img-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 占位方块 - 柔和浅灰不暗沉 */
.placeholder-box {
  width: 50%;
  height: 50%;
  background-color: #ECECEC;
  border-radius: 12rpx;
}

.product-name {
  font-size: 26rpx;
  color: #3A3A3A;
  line-height: 38rpx;
  padding: 20rpx 20rpx 8rpx;
  height: 76rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx 0;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #3A3A3A;
  font-weight: 700;
}

.price-value {
  font-size: 30rpx;
  color: #3A3A3A;
  font-weight: 700;
}

/* 购物车按钮 - 哑光豆沙酒红 圆形+白色加号 */
/* 距卡片右边缘8px(16rpx)，由product-bottom的padding-right:16rpx实现 */
.cart-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: #B55A5A;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-btn-icon {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}

/* 底部留白 */
.bottom-space {
  height: 40rpx;
}