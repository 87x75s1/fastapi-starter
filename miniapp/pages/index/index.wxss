.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 横幅 */
.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 40rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
}

.banner-content {
  flex: 1;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.banner-icon {
  font-size: 80rpx;
}

/* 功能入口 */
.features {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 20rpx;
  background: #fff;
  margin-bottom: 24rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.feature-icon {
  font-size: 44rpx;
}

.feature-name {
  font-size: 24rpx;
  color: #666;
}

/* 区块 */
.section {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 状态卡片 */
.status-card {
  padding: 10rpx 0;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.status-row:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 26rpx;
  color: #333;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-ok {
  color: #4CAF50;
}

.status-err {
  color: #f44336;
}

/* 技术栈列表 */
.tech-list {
  padding: 10rpx 0;
}

.tech-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.tech-item:last-child {
  border-bottom: none;
}

.tech-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.tech-desc {
  font-size: 24rpx;
  color: #999;
}