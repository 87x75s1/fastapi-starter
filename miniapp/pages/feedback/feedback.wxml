<view class="container">
  <!-- 提交反馈 -->
  <view class="section">
    <view class="section-title">意见反馈</view>
    <textarea class="feedback-input" placeholder="请输入您的反馈内容..." maxlength="2000"
              value="{{content}}" bindinput="onContentInput" />
    <input class="contact-input" placeholder="联系方式（选填）" maxlength="100"
           value="{{contact}}" bindinput="onContactInput" />
    <button class="btn-submit" bindtap="onSubmit">提交反馈</button>
  </view>

  <!-- 反馈记录 -->
  <view class="section">
    <view class="section-title">反馈记录</view>
    <view class="feedback-list">
      <view class="feedback-item" wx:for="{{feedbacks}}" wx:key="id">
        <view class="feedback-header">
          <text class="feedback-status status-{{item.status}}">{{item.status === 0 ? '待处理' : '已回复'}}</text>
          <text class="feedback-time">{{item.created_at}}</text>
        </view>
        <text class="feedback-content">{{item.content}}</text>
        <view class="feedback-reply" wx:if="{{item.reply}}">
          <text class="reply-label">回复：</text>
          <text class="reply-text">{{item.reply}}</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && feedbacks.length === 0}}"><text>暂无反馈记录</text></view>
    <view class="loading" wx:if="{{loading}}"><text>加载中...</text></view>
    <view class="no-more" wx:if="{{noMore && feedbacks.length > 0}}"><text>没有更多了</text></view>
  </view>
</view>