<view class="container">
  <view class="header">
    <view class="logo-wrap">
      <text class="logo-icon">🚀</text>
    </view>
    <text class="app-title">FastAPI 小程序</text>
    <text class="app-desc">手机号密码登录</text>
  </view>

  <view class="form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input
        class="input"
        password="{{true}}"
        maxlength="20"
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <button class="btn-primary" bindtap="onLogin" loading="{{loading}}">
      登录
    </button>

    <view class="footer-links">
      <text class="link" bindtap="goRegister">还没有账号？去注册</text>
    </view>
  </view>
</view>