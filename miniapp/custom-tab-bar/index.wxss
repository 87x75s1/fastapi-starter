/* ========== 自定义TabBar - 炭灰极简轻奢 ========== */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  background-color: #FFFFFF;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

/* 顶部极浅灰分割线 */
.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background-color: #EEEEEE;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 10rpx;
  position: relative;
}

/* 图标 - 统一尺寸 */
.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 文字 - 浅灰/深炭灰 */
.tab-text {
  font-size: 20rpx;
  color: #BBBBBB;
  margin-top: 6rpx;
  line-height: 1;
}

.tab-text-active {
  color: #3A3A3A;
  font-weight: 500;
}

/* 选中指示小圆点 - 极小不抢眼 */
.tab-dot {
  width: 0;
  height: 0;
  border-radius: 50%;
  margin-top: 6rpx;
  transition: all 0.2s ease;
}

.tab-dot-show {
  width: 8rpx;
  height: 8rpx;
  background-color: #3A3A3A;
}