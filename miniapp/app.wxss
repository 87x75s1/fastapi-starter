/* ========== 全局样式 - 炭灰极简轻奢 高保真 ========== */

/* 设计色板
  页面背景: #F8F9FA
  卡片底色: #FFFFFF
  主文字深炭灰: #3A3A3A
  次要文字: #888888
  弱文字/占位: #BBBBBB / #CCCCCC
  功能强调色哑光豆沙酒红: #B55A5A
  分割线: #EEEEEE
  柔和浅灰(占位/搜索框): #F5F5F5
  柔和占位方块: #ECECEC
  深灰背景(我的页头部): #3A3A3A
  圆角: 16rpx统一
  阴影: 0 2rpx 12rpx rgba(0,0,0,0.02)极淡
*/

page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #3A3A3A;
  background: #F8F9FA;
  -webkit-font-smoothing: antialiased;
}

/* 清除按钮默认样式 */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
}

button::after {
  border: none;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 点击缩放动画 */
.tap-scale {
  transition: transform 0.15s ease;
}

.tap-scale:active {
  transform: scale(0.92);
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}