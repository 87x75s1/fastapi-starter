/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  -webkit-font-smoothing: antialiased;
}

/* 清除按钮默认样式 */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
}

button::after {
  border: none;
}

/* 通用文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 安全区域底部留白 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}