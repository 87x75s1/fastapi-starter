# ========== 应用配置 ==========
APP_NAME=FastAPI 小程序后台
APP_VERSION=1.0.0
DEBUG=True

# ========== 数据库配置 ==========
# 默认使用 SQLite，切换 MySQL 示例：
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dbname
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ========== JWT 配置 ==========
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ========== 文件上传配置 ==========
UPLOAD_DIR=./uploads
UPLOAD_URL_PREFIX=/static
ALLOWED_EXTENSIONS_STR=.jpg,.jpeg,.png,.gif,.webp
MAX_FILE_SIZE=5242880